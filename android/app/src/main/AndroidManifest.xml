<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.smartvoice.notes">

    <!-- إذن استخدام الميكروفون للتعرف على الصوت وتسجيل المذكرات -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- إذن الاتصال بالإنترنت لمعالجة الصوت عبر السيرفر والذكاء الاصطناعي -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- إذن إرسال الإشعارات للتنبيهات المجدولة في Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- أذونات الاهتزاز والاستيقاظ للتنبيهات -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- إذن الحماية بالبصمة البيومترية للملاحظات وقفل التطبيق -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- متطلب استعلام خدمة التعرف على الصوت في Android 11 (API 30) وما بعده -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Smart Voice Notes"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartVoiceNotes">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SmartVoiceNotes">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
